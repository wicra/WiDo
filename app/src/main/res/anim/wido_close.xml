<?xml version="1.0" encoding="utf-8"?>
<!-- Retour à l'accueil : la page se rétracte et s'efface, vers la carte d'où elle venait. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:duration="220">
    <scale android:fromXScale="1" android:toXScale="0.9" android:fromYScale="1" android:toYScale="0.9"
        android:pivotX="50%" android:pivotY="70%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
