<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WiDo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wido_bg</item>
        <item name="android:statusBarColor">@color/wido_bg</item>
        <item name="android:navigationBarColor">@color/wido_bg</item>
        <item name="android:colorAccent">@color/wido_accent</item>
    </style>

    <!-- Lecteur léger : fond noir, sans animation d'ouverture (il prend la suite de la page sans à-coup). -->
    <style name="Theme.WiDo.Player" parent="Theme.WiDo">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Fenêtre de partage : posée sur l'appli d'origine, fond assombri. -->
    <style name="Theme.WiDo.Translucent" parent="Theme.WiDo">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
